# App Configuration
APP_NAME="Clipboard Sync API"
APP_VERSION=1.0.1

# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3002
TRUSTED_IPS=127.0.0.1

# Database Configuration
DB_HOST=DB
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_PORT=3306

# JWT Configuration
JWT_ACCESS=token
JWT_ACCESS_EXPIRES_IN=7d # 7 hari
JWT_REFRESH=token
JWT_REFRESH_EXPIRES_IN=30d # 30 Hari
HEALTH_TOKEN=health_token

# Session Configuration
SESSION_KEY=sesi_token
SESSION_EXPIRE_HOURS=2 # 2 jam

# Clipboard Configuration
CLIPBOARD_EXPIRE_HOURS=168 # 168 jam = 1 minggu

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5 # maximum login attempts before lock
ACCOUNT_LOCK_TIME=15 # in minutes
