# App Configuration
APP_NAME="Clipboard Sync API"
VERSION=1.0.0

# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3002
TRUSTED_IPS=127.0.0.1

# Database Configuration
DB_HOST=127.0.0.1
DB_DATABASE=
DB_USER=
DB_PASS=
DB_PORT=

# JWT Configuration
JWT_SECRET=YourJWTSecret
JWT_EXPIRES_IN=7d # 7 hari
REFRESH_TOKEN_SECRET=YourRefreshTokenSecret
REFRESH_TOKEN_EXPIRES_IN=30d # 30 Hari
HEALTH_TOKEN=YourHealthToken

# Session Configuration
SESSION_KEY=YourSessionSecret
SESSION_EXPIRE_HOURS=2 # 2 jam

# Clipboard Configuration
CLIPBOARD_EXPIRE_HOURS=168 # 168 jam = 1 minggu

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5 # maximum login attempts before lock
ACCOUNT_LOCK_TIME=15 # in minutes
